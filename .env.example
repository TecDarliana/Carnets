# Copia este archivo como `.env` y completa los valores.
# Las credenciales nunca van al repositorio (.env está en .gitignore).

SIGLAS_DB_HOST=172.17.0.181
SIGLAS_DB_PORT=5432
SIGLAS_DB_NAME=siglas
SIGLAS_DB_USER=siglas
SIGLAS_DB_PASSWORD=tu_contraseña

# URL de la foto del funcionario en la web de SIGLAS ({ci} = cédula)
SIGLAS_FOTO_URL=http://172.17.0.180/images/fotos_personal/{ci}.jpg